{
  "name": "WhatsApp CRM · desarrollo cloud",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "CRM sandbox · datos ficticios", "onAutoForward": "notify", "visibility": "private" }
  },
  "postCreateCommand": "bash scripts/cloud-bootstrap.sh",
  "remoteUser": "node"
}
