NODE_ENV=development
# Comma-separated existing user IDs authorized to administer contracts across stores.
# Leave empty until the account owner explicitly designates the platform operator.
PLATFORM_ADMIN_USER_IDS=
PORT=3001
DATABASE_URL=postgresql://crm:change-me@localhost:5432/crm
# Generate a random secret with at least 32 characters. No default is accepted.
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# Exact externally registered URL origin, required for Twilio signature validation.
CRM_PUBLIC_URL=https://your-backend.example
# Set only when the network topology really has this many trusted reverse proxies.
# TRUST_PROXY_HOPS=1
# Provider secrets: configure the active provider before enabling its webhook.
KAPSO_WEBHOOK_SECRET=
META_APP_SECRET=
META_APP_ID=
META_GRAPH_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=
# Opcional: secreto exclusivo para cifrar tokens; si se omite se deriva de JWT_SECRET.
META_TOKEN_ENCRYPTION_KEY=
SHOPIFY_API_SECRET=
# AI provider for every text, tool-use and vision workflow: anthropic (default) or deepseek.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required only when AI_PROVIDER=deepseek. Keep every API key in environment secrets.
DEEPSEEK_API_KEY=
# Optional model overrides. Defaults to deepseek-flash for every DeepSeek tier.
DEEPSEEK_MODEL=
DEEPSEEK_FAST_MODEL=
DEEPSEEK_SMART_MODEL=
DEEPSEEK_VISION_MODEL=
# Optional Anthropic tier overrides.
ANTHROPIC_FAST_MODEL=
ANTHROPIC_SMART_MODEL=
ANTHROPIC_VISION_MODEL=
# Optional audio transcription fallback. The transcript then enters the active AI provider.
AUDIO_TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AUDIO_TRANSCRIPTION_LANGUAGE=es
# Meta credentials (also configurable per organization in the application).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=
# Operator-controlled HTTPS origins, never tenant input. Empty denies Evolution requests.
# Configure all existing trusted servers before approving this security change for production.
EVOLUTION_ALLOWED_ORIGINS=
# Shopify store credentials.
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
